# Prometheus server secrets. Copy to `.env` (same folder) and fill in.
# Loaded by server/gpt_bridge.py at import. Do NOT commit the real .env.

# Required to wire GPT into the Plan Room. Without it, the GPT side of every
# debate returns an error message and only Fable (Claude) participates.
OPENAI_API_KEY=sk-your-key-here

# Optional. Defaults to gpt-4o. Set to whatever GPT model your API account has.
# OPENAI_MODEL=gpt-4o
